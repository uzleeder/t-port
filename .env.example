# Copy to .env (never commit .env). All backend settings use the TPORT_ prefix.

# --- Docker Compose database (local only) ---
POSTGRES_USER=tport
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=tport

# --- API ---
TPORT_ENVIRONMENT=development            # development | test | production
TPORT_DATABASE_URL=postgresql+psycopg://tport:change-me-locally@127.0.0.1:5432/tport
TPORT_CORS_ORIGINS=["http://localhost:2028"]  # JSON list; production: your https origin only
TPORT_LOG_LEVEL=INFO
TPORT_LOG_FORMAT=text                    # text | json
TPORT_COOKIE_SECURE=false                # always forced on when TPORT_ENVIRONMENT=production
TPORT_SESSION_TTL_HOURS=336
TPORT_RATE_LIMIT_PER_MINUTE=120
TPORT_AUTH_RATE_LIMIT_PER_MINUTE=10
TPORT_AI_RATE_LIMIT_PER_MINUTE=20
TPORT_RATE_LIMIT_BACKEND=database       # auth/AI limits shared by all workers (memory = per process)
TPORT_LOGIN_FAILURE_LIMIT=5
TPORT_LOGIN_FAILURE_WINDOW_SECONDS=900
TPORT_ACTIVITY_RETENTION_DAYS=180

# Data freshness (seconds since the data was retrieved from its source)
TPORT_DATA_STALE_AFTER_SECONDS=900
TPORT_DATA_EXPIRE_AFTER_SECONDS=21600
# live = generate demo data per request; stored = serve the last `python -m app.cli import-demo`
TPORT_DEMO_PROVIDER_MODE=live

# Transfer rules (minutes)
TPORT_TRANSFER_MIN_MINUTES_SAME_STATION=20
TPORT_TRANSFER_MIN_MINUTES_STATION_CHANGE=60
TPORT_TRANSFER_MIN_MINUTES_TO_FLIGHT=120
TPORT_TRANSFER_MAX_WAIT_MINUTES=360

# AI interpreter: "rules" (no external calls) or "anthropic" (needs a key; falls back to rules)
TPORT_AI_ENGINE=rules
TPORT_AI_API_KEY=
TPORT_AI_MODEL=claude-opus-5-5
# Optional: your contracted USD price per million tokens, for the AI cost metric (unset = no cost metric)
TPORT_AI_INPUT_USD_PER_MTOK=
TPORT_AI_OUTPUT_USD_PER_MTOK=

# Operations: bearer token for /health/providers and /metrics (>= 32 chars in production).
# Leave empty to disable both endpoints. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TPORT_OPS_TOKEN=

# Development/test only: lets searches pass simulate=stale|outage. Refused in production.
TPORT_ENABLE_FAULT_SIMULATION=false
# Fictional bookable TEST provider (booking.synthrail.test) for dev/e2e only; refused in production.
TPORT_ENABLE_SYNTHETIC_BOOKING=false

# Uvicorn behind a proxy: IPs allowed to set X-Forwarded-For (the web container / proxy network)
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Web (Next.js) ---
API_INTERNAL_URL=http://127.0.0.1:8000   # server-side address of the API; never exposed to browsers
