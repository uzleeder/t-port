# Vercel Dashboard -> Project -> Settings -> Environment Variables.
# Use different databases for Preview and Production. Never commit real credentials.
# Root Directory: repository root (.), not frontend/.

TPORT_ENVIRONMENT=production
TPORT_CORS_ORIGINS=["https://YOUR-PROJECT.vercel.app"]
# Neon/Supabase's pooled PostgreSQL URL. DATABASE_URL from Marketplace is also supported.
TPORT_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLER-HOST/tport?sslmode=require
# Direct connection for the manual migration command (do not expose it in frontend code).
TPORT_MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-DIRECT-HOST/tport?sslmode=require
TPORT_LOG_FORMAT=json
TPORT_RATE_LIMIT_BACKEND=database
TPORT_AI_ENGINE=rules
TPORT_ENABLE_DEMO_PROVIDER=true
TPORT_DEMO_PROVIDER_MODE=live
TPORT_ENABLE_FAULT_SIMULATION=false
TPORT_ENABLE_SYNTHETIC_BOOKING=false
# Optional operational endpoints. Empty leaves /metrics and /health/providers disabled.
TPORT_OPS_TOKEN=

# API_INTERNAL_URL is generated by the Vercel service binding. Do NOT set it manually.
# Never use NEXT_PUBLIC_ for database credentials or API keys.
